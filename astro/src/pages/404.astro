---
import Layout from "../layouts/Layout.astro";
---

<style>
  main {
    max-width: 40rem;
    margin: 0 auto;
    padding: 4rem 2rem;
    color: #2c3e50;
  }

  h1 {
    font-size: 2rem;
    margin-bottom: 1rem;
  }

  p + h2 {
    margin-top: 2.5rem;
  }

  h2 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
  }

  a {
    color: #2c3e50;
  }
</style>

<Layout>
  <main id="main-content">
    <h1>Seite nicht gefunden</h1>
    <p>Diese Seite existiert leider nicht. <a href="/">Zur Startseite</a></p>

    <h2 lang="en">Page not found</h2>
    <p lang="en">This page does not exist. <a href="/en/">Go to the homepage</a></p>
  </main>
</Layout>
