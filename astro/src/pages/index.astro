---
import Header from "../components/Header.astro";
import Jobs from "../components/jobs/Jobs.astro";
import Sidebar from "../components/sidebar/Sidebar.astro";
import Layout from "../layouts/Layout.astro";
import { jobs } from "../lib/content/jobs.ts";
---

<style>
    @import "./index.css";
</style>

<Layout>
    <div class="container">
        <Sidebar />
        <main id="main-content" class="content">
          <h2 id="summary-heading">Zusammenfassung</h2>
          <section aria-labelledby="summary-heading">
            <p class="summary">
              Seit 6 Jahren bin ich leidenschaftlicher Full-Stack-Entwickler
              mit Fokus auf Webentwicklung. Ich arbeite gerne testgetrieben
              und setze auf saubere und skalierbare Architekturen. In meiner
              Freizeit spiele ich Handball und studiere seit Oktober 2024
              berufsbegleitend Informatik/IT-Sicherheit.
            </p>
          </section>

          <h2 id="jobs-heading">Berufserfahrung</h2>
          <section class="content-section" aria-labelledby="jobs-heading">
            <Jobs jobs={jobs} />
          </section>

          <h2 id="education-heading">Ausbildung</h2>
          <section class="content-section" aria-labelledby="education-heading">
            <article>
                <Header
                  title="Informatik/IT-Sicherheit (Berufs&shy;begleitend)"
                  subTitle="10/2024 - laufend"
                  company="Friedrich-Alexander-Universität"
                  city="Erlangen"
                />
            </article>

            <article>
                <Header
                  title="Fachinformatiker für Anwendungsentwicklung"
                  subTitle="09/2016 - 02/2019"
                  company="Jochen Schweizer Technology Solutions GmbH"
                  city="München"
                />
            </article>
          </section>

          <h2 id="certificates-heading">Zertifikate</h2>
          <section class="content-section" aria-labelledby="certificates-heading">
            <article>
              <Header
                title="Grundlagen Klassisches Projektmanagement"
                subTitle="12/2024"
                company="Brainbirds GmbH"
                city="München"
              />
              <p>
                Vermittlung klassischer
                Projektmanagement-Grundlagen: Projektinitiierung,
                Planung, Rollendefinition, Stakeholder-Management,
                Risikomanagement und Kommunikation
              </p>
            </article>

            <article>
              <Header
                title="Agile Methoden Seminar"
                subTitle="11/2020"
                company="Brainbirds GmbH"
                city="München"
              />
              <p>
                Einführung in agile Methoden: Design Thinking,
                Business Model Generation, Lean Startup sowie Scrum
                und Kanban
              </p>
            </article>
          </section>

          <h2 id="engagement-heading">Engagement</h2>
          <section class="content-section" aria-labelledby="engagement-heading">
            <article>
              <Header
                title="Freiwilliges Soziales Jahr"
                subTitle="07/2013 - 08/2014"
                company="Montessori-Schule"
                city="München"
              />
              <p>
                Betreuung und Unterstützung von Siebtklässlern in
                einem Bildungsdorf. Klassenassistenz in
                verschiedenen Fächern sowie gezielte
                Englisch-Nachhilfe in Kleingruppen von 2-3 Schülern.
              </p>
            </article>

            <article>
              <Header
                title="Ehrenamtlicher Jugend&shy;trainer"
                subTitle="2018 - 2022"
                company="TSV Milbertshofen Handball"
                city="München"
              />
              <p>
                Training und Betreuung von Jugendlichen (13-18
                Jahre). Entwicklung von Führungskompetenzen,
                Teamfähigkeit und Kommunikationsstärke durch
                Gruppenleitung und Konfliktmanagement.
              </p>
            </article>
          </section>
        </main>
    </div>
</Layout>
