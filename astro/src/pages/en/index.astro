---
import Header from "../../components/Header.astro";
import Jobs from "../../components/jobs/Jobs.astro";
import Sidebar from "../../components/sidebar/en/Sidebar.astro";
import Layout from "../../layouts/Layout.astro";
import { jobsEn } from "../../lib/content/jobs.ts";
---

<style>
  @import '../index.css';
</style>

<Layout lang="en">
  <div class="container">
    <Sidebar />
    <main id="main-content" class="content">
      <h2 id="summary-heading">Summary</h2>
      <section class="content-section" aria-labelledby="summary-heading">
        <p class="summary">
          For 6 years, I have been a passionate Full-Stack Developer with a focus on web development.
          I enjoy working test-driven and rely on clean and scalable architectures.
          In my free time, I play handball and have been studying Computer Science/IT Security part-time since October 2024.
        </p>
      </section>

      <h2 id="jobs-heading">Professional Experience</h2>
      <section class="content-section" aria-labelledby="jobs-heading">
        <Jobs jobs={jobsEn} />
      </section>

      <h2 id="education-heading">Education</h2>
      <section class="content-section" aria-labelledby="education-heading">
        <Header
          title="Computer Science / IT Security (Part-time)"
          subTitle="10/2024 - ongoing"
          company="Friedrich-Alexander-Universität"
          city="Erlangen"
        />

        <Header
          title="IT Specialist for Application Development"
          subTitle="09/2016 - 02/2019"
          company="Jochen Schweizer Technology Solutions GmbH"
          city="Munich"
        />
      </section>

      <h2 id="certificates-heading">Certificates</h2>
      <section class="content-section" aria-labelledby="certificates-heading">
        <Header
          title="Fundamentals of Classical Project Management"
          subTitle="12/2024"
          company="Brainbirds GmbH"
          city="Munich"
        />
        <p>
          Teaching classical project management fundamentals: project initiation, planning,
          role definition, stakeholder management, risk management, and communication
        </p>

        <Header
          title="Agile Methods Seminar"
          subTitle="11/2020"
          company="Brainbirds GmbH"
          city="Munich"
        />
        <p>
          Introduction to agile methods: Design Thinking, Business Model Generation, Lean Startup as well as Scrum and Kanban
        </p>
      </section>

      <h2 id="engagement-heading">Engagement</h2>
      <section class="content-section" aria-labelledby="engagement-heading">
        <Header
          title="Voluntary Social Year"
          subTitle="07/2013 - 08/2014"
          company="Montessori School"
          city="Munich"
        />
        <p>
          Care and support of seventh graders in an educational village.
          Class assistance in various subjects as well as targeted English tutoring
          in small groups of 2-3 students.
        </p>

        <Header
          title="Volunteer Youth Coach"
          subTitle="2018 - 2022"
          company="TSV Milbertshofen Handball"
          city="Munich"
        />
        <p>
          Training and coaching of youth players (13-18 years).
          Development of leadership skills, teamwork, and
          communication skills through group leadership and conflict management.
        </p>
      </section>
    </main>
  </div>
</Layout>
