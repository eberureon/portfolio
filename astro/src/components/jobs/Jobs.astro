---
import Header from "../../components/Header.astro";
import type { Job } from "../../lib/types/jobs.ts";

interface Props {
  jobs: Job[];
}

const { jobs } = Astro.props;
const locale = Astro.currentLocale ?? "de";
---

<style>
  ul {
    padding-inline-start: 2rem;
  }

  details {
    margin-top: 0.5rem;

    summary {
      cursor: pointer;
      user-select: none;
    }
  }

  .technologies {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.5rem;

    span {
      width: fit-content;
      background-color: #2c3e50;
      border-radius: 0.5rem;
      padding: 0.125rem 0.5rem;
      color: #fff;
      text-align: center;
      font-size: 0.875rem;
    }
  }
</style>

<section id="jobs">
  {jobs.map((job) => {
  const { jobName, time, company, companyUrl, city, responsibilities, technologies } = job;
  const isEn = locale === "en";
  const technologiesLabel = isEn ? `Tech stack for ${company}` : `Tech Stak bei ${company}`;
  const responsibilitiesLabel = isEn ? `Responsibilities at ${company}`: `Tätigkeiten bei ${company}`

    return (
      <article>
        <Header
          title={jobName}
          subTitle={time}
          city={city}
          company={company}
          url={companyUrl}
        />
        <ul aria-label={responsibilitiesLabel}>
          {responsibilities.map((responsibility: string) => <li>{responsibility}</li>)}
        </ul>

        <details aria-label={technologiesLabel}>
          <summary>Tech Stack</summary>
          <div class="technologies" role="list">
            {technologies.map((technology) => <span role="listitem">{technology}</span>)}
          </div>
        </details>
      </article>
    )
  })}
</section>
