---
import Header from "../../components/Header.astro";
import type { Job } from "../../lib/types/jobs.ts";

interface Props {
  jobs: Job[];
}

const { jobs } = Astro.props;
---

<style>
  ul {
    padding-inline-start: 2rem;
  }

  details {
    margin-top: 0.5rem;

    summary {
      cursor: pointer;
      user-select: none;
    }
  }

  .technologies {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.5rem;

    span {
      width: fit-content;
      background-color: #2c3e50;
      border-radius: 0.5rem;
      padding: 0.125rem 0.5rem;
      color: #fff;
      text-align: center;
      font-size: 0.875rem;
    }
  }
</style>

<section id="jobs">
  {jobs.map((job) => {
  const { jobName, time, company, companyUrl, city, responsibilities, technologies } = job;

    return (
      <Header
        title={jobName}
        subTitle={time}
        city={city}
        company={company}
        url={companyUrl}
      />
      <ul aria-label={`Tätigkeiten bei ${company}`}>
        {responsibilities.map((responsibility: string) => <li>{responsibility}</li>)}
      </ul>

      <details aria-label={`Technologien für ${company} Position`}>
        <summary>Tech Stack</summary>
        <div class="technologies">
          {technologies.map((technology) => <span>{technology}</span>)}
        </div>
      </details>
    )
  })}
</section>
