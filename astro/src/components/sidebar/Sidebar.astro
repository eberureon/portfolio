---
import { Image } from "astro:assets";
import ProfileImage from "../../assets/profile.jpg";
---

<style>
    @import "./index.css";
</style>

<aside class="sidebar" aria-label="Sidebar">
    <div class="content">
        <nav class="language-switcher" aria-label="Sprachauswahl">
            <a href="/" class="active" aria-label="Deutsche Version" aria-current="page">DE</a>
            <span aria-hidden="true">|</span>
            <a href="/en" aria-label="English version">EN</a>
        </nav>
        <div class="profile-container">
            <Image
                class="profile-image"
                src={ProfileImage}
                alt="Profilbild von Leon Ebel"
                width={250}
                widths={[150, 200, 250, 300]}
                quality={85}
                fetchpriority="high"
                format="webp"
                decoding="async"
                loading="eager"
                layout="constrained"
            />
        </div>
        <h1>Leon Ebel</h1>
        <strong class="job-title">Software Developer</strong>
        <address aria-label="Kontakt und Social Links">
            <span>München</span>
            <span aria-hidden="true">|</span>
            <a
                href="mailto:kontakt@ebelleon.de"
                aria-label="E-Mail an Leon Ebel senden">E-Mail</a
            >
            <span aria-hidden="true">|</span>
            <a
                href="https://www.github.com/eberureon"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="GitHub Profil von Leon Ebel (öffnet in neuem Tab)"
                >GitHub</a
            >
            <span aria-hidden="true">|</span>
            <a
                href="https://www.linkedin.com/in/ebelleon"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="LinkedIn Profil von Leon Ebel (öffnet in neuem Tab)"
                >LinkedIn</a
            >
            <!-- <span>| Verfügbar ab sofort</span> -->
        </address>
    </div>

    <div class="content">
        <strong>Technische Expertise</strong>
        <hr />
        <p>
            <b>Programmiersprachen & Framekworks:</b> JavaScript / TypeScript, React,
            Next.js, Node.js, Java
        </p>
        <p>
            <b>Testing:</b> Test-Driven Development (TDD), Jest, Cypress, Playwright
        </p>
        <p>
            <b>Datenbanken & APIs:</b> SQL, REST, GraphQL, MongoDB, SQLite
        </p>
        <p>
            <b>DevOps & Infrastructure:</b> Unix, Docker, Google Cloud Platform, AWS
        </p>
        <p><b>User Interface (UI):</b> CSS, TailwindCSS, Sass, Figma</p>
        <p>
            <b>Entwicklungs Tools:</b> neovim, VSCode, Git, GitHub Actions
        </p>
        <p>
            <b>Projektmanagement & Workflows:</b> Scrum, Agile, Confluence, Jira,
            Linear
        </p>
    </div>

    <div class="content">
        <strong>Weitere Informationen</strong>
        <hr />
        <p>
            <b>Sprachen:</b> Deutsch (Muttersprache), Englisch (verhandlungssicher)
        </p>
        <p>
            <b>Interessen:</b> Web-Entwicklung, IT-Sicherheit, Homeserver, Hobby Barista,
            Handball
        </p>
    </div>
</aside>
